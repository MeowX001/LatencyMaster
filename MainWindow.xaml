<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LatencyMaster.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Latency Master">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid Background="#101214">
      <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="20" Margin="0,4,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Text="Network latency" FontSize="30" FontWeight="SemiBold" Foreground="#F4F6F8" />
                <TextBlock Text="Watch the response time to the places that matter." FontSize="14" Foreground="#9CA3AA" />
            </StackPanel>
            <Button x:Name="AddTargetButton" Grid.Column="1" Content="＋  Add target" Click="AddTarget_Click" VerticalAlignment="Center" Padding="18,10" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="104" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="TARGET" FontSize="11" FontWeight="SemiBold" Foreground="#777F87" />
            <TextBlock Grid.Column="2" Text="PACKETS" FontSize="11" FontWeight="SemiBold" Foreground="#777F87" />
            <TextBlock Grid.Column="3" Text="RECENT HISTORY" FontSize="11" FontWeight="SemiBold" Foreground="#777F87" />
            <TextBlock Grid.Column="4" Text="LATEST" FontSize="11" FontWeight="SemiBold" Foreground="#777F87" HorizontalAlignment="Right" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TargetsPanel" Spacing="8" />
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatus" Text="Starting checks…" FontSize="12" Foreground="#858D95" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <TextBlock Text="Check every" Foreground="#A7ADB3" VerticalAlignment="Center" />
                <ComboBox x:Name="IntervalCombo" Width="120" SelectedIndex="0" SelectionChanged="IntervalCombo_SelectionChanged">
                    <ComboBoxItem Content="1 second" Tag="1" />
                    <ComboBoxItem Content="2 seconds" Tag="2" />
                    <ComboBoxItem Content="5 seconds" Tag="5" />
                    <ComboBoxItem Content="10 seconds" Tag="10" />
                </ComboBox>
            </StackPanel>
        </Grid>
      </Grid>
    </Grid>
</Window>
